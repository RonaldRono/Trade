                                                                   {
                                                                       "nodeType":  "paragraph",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Trading boom and crash indices, synthetic indices and foreign exchange on margin carries a high level of risk and may not be suitable for all investors. High volatility can work both to your advantage and to your disadvantage. Before you use any Treads Algo software, signal feed or copy-trading service you should carefully consider your investment objectives and level of experience."
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "heading-2",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "What we provide"
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "paragraph",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Treads Algo provides quantitative software tools, algorithmic signals and educational indicators. We do not manage money, we do not accept deposits, and we do not guarantee profits. Nothing we publish is investment advice."
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "unordered-list",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "Indicators are analytical tools. They calculate cluster accumulation, variance and liquidity conditions on the chart you provide."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       },
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "VIP signals are observations of an algorithm\u0027s output at a point in time. They are not instructions to trade."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       },
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "Copy trading executes a pre-defined strategy against your own account. You remain responsible for every position it opens."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "heading-2",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Leverage and synthetic indices"
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "paragraph",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Boom and Crash indices are synthetic instruments with no external underlying asset. Their price path is generated by a volatility algorithm that spikes a fixed percentage of ticks on a fixed interval. This design produces occasional very large moves in either direction, and a position held across a spike can lose its entire margin very quickly."
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "heading-2",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Performance figures"
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "paragraph",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Accuracy rates such as 95.2% and 97.2% are measured on specific live accounts over specific periods, on specific instruments and timeframes. They are not a prediction of future results. Different broker servers, spreads, slippage and liquidity conditions will produce different results, and a losing streak of comparable length is entirely possible."
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "heading-2",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "The $100 to $100k challenge"
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "paragraph",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "The challenge is a high-risk, time-boxed copy-trading arrangement. Slot allocation is not guaranteed, the fee is non-refundable, and outcomes depend entirely on market conditions during the three-day window. A 6% peak-to-trough drawdown guard is enforced automatically and may close your positions before the target is reached."
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "heading-2",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Your responsibilities"
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "unordered-list",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "Never risk capital you cannot afford to lose."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       },
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "Never risk more than 3% of your account equity on a single spike signal."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       },
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "Test every model on a demo account before risking live capital, and validate the results independently."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       },
                                                                                       {
                                                                                           "nodeType":  "list-item",
                                                                                           "content":  [
                                                                                                           {
                                                                                                               "nodeType":  "paragraph",
                                                                                                               "content":  [
                                                                                                                               {
                                                                                                                                   "nodeType":  "text",
                                                                                                                                   "value":  "Review the broker terms of your own account. Synthetic index availability, leverage and margin rules vary between Deriv and Weltrade entities."
                                                                                                                               }
                                                                                                                           ]
                                                                                                           }
                                                                                                       ]
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "heading-2",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "Limitation of liability"
                                                                                       }
                                                                                   ]
                                                                   },
                                                                   {
                                                                       "nodeType":  "paragraph",
                                                                       "content":  [
                                                                                       {
                                                                                           "nodeType":  "text",
                                                                                           "value":  "To the fullest extent permitted by law, Treads Algo and its personnel are not liable for trading losses, lost profits, data loss, service interruption or broker-side execution failures arising from the use of our software, signals or copy-trading services. Total liability is limited to the amount you paid us in the twelve months preceding the claim."
                                                                                       }
                                                                                   ]
                                                                   }
